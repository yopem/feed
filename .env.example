# Copy to .env at repository root. Never commit .env.
NODE_ENV=development
SERVER_PORT=4000
WEB_PORT=3000
WEB_URL=http://localhost:3000
VITE_SERVER_URL=http://localhost:4000
DATABASE_URL=postgres://feed:feed@localhost:5432/feed
TEST_DATABASE_URL=postgres://feed:feed@localhost:5432/feed_test
REDIS_URL=redis://localhost:6379
AUTH_ISSUER=https://auth.yopem.com
AUTH_CLIENT_ID=yopem
AUTH_CALLBACK_URL=http://localhost:4000/auth/callback
COOKIE_DOMAIN=
AUTH_SIGNUP_ENABLED=true
FEED_REFRESH_MINUTES=30
OPENAPI_ENABLED=true
