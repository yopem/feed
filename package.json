{
  "name": "yopem-feed",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "zod": "^4.6.5",
      "hono": "^4.13.12",
      "@hono/zod-openapi": "^1.6.3",
      "@openauthjs/openauth": "^0.4.3",
      "@types/bun": "^1.4.2",
      "oxlint": "^1.86.0",
      "oxlint-tsgolint": "^7.0.2003",
      "oxfmt": "^0.71.0",
      "oxlint-tailwindcss": "^1.14.0",
      "fast-xml-parser": "^5.11.2",
      "@tanstack/react-start": "^1.168.60",
      "@tanstack/react-router": "^1.170.41",
      "@tanstack/react-query": "^5.104.0",
      "@tanstack/react-form": "^1.33.5",
      "@tanstack/react-router-ssr-query": "^1.167.3",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "vite": "^8.3.2",
      "@vitejs/plugin-react": "^6.1.1",
      "@tailwindcss/vite": "^4.3.3",
      "tailwindcss": "^4.3.3",
      "@base-ui/react": "^1.8.0",
      "drizzle-orm": "^0.45.3",
      "drizzle-kit": "^0.31.11",
      "srvx": "^1.0.5",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "next-themes": "^0.4.6",
      "lucide-react": "^1.49.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "tailwind-merge": "^3.7.0",
      "tw-animate-css": "^1.4.0",
      "drizzle-zod": "^0.8.3",
      "@tanstack/router-cli": "^1.167.40",
      "@hono/swagger-ui": "^0.6.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter \"./apps/*\" dev",
    "build": "bun run --filter server build && bun run --filter web build",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "lint": "CI=true oxlint --deny-warnings .",
    "lint:fix": "CI=true oxlint --fix .",
    "typecheck": "bun run --filter web routes:generate && tsc --noEmit",
    "test": "bun test",
    "test:integration": "CI=false RUN_DB_TESTS=true bun test packages/db/test/integration"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@yopem-ui/oxlint-plugin": "^0.0.2",
    "@yopem/oxlint-config": "^0.1.4",
    "@yopem/typescript-config": "^0.2.3",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "lefthook": "^2.1.15",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tailwindcss": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
