    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rpc": "workspace:*",
    "srvx": "catalog:",
    "ui": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
